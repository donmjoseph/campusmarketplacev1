{
  "name": "campus-marketplace",
  "version": "1.0.0",
  "description": "Full-stack MERN Campus Marketplace for WSU",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down",
    "db:dump": "node scripts/mongoDump.js",
    "db:restore": "node scripts/mongoRestore.js",
    "zip:submission": "powershell -ExecutionPolicy Bypass -File ./scripts/createSubmissionZip.ps1",
    "start": "npm run start --prefix server",
    "seed": "npm run seed --prefix server",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix client && npm run lint --prefix server"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
